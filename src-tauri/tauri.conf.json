{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteDeskRDP",
  "version": "0.6.3",
  "identifier": "com.nojan.remotedesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "RemoteDeskRDP",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "remotedesk"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "resources": [
      "resources/freerdp/**/*",
      "resources/licenses/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "RDP, VNC and SSH connections for macOS",
    "longDescription": "RemoteDeskRDP manages secure RDP, VNC, SSH, SFTP and Mosh connections on macOS.",
    "copyright": "Copyright © 2026 Norbert Jander",
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "Developer ID Application: Norbert Jander (TXF2V79Z6N)",
      "hardenedRuntime": true
    }
  }
}
