{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Profilzentrale: eigene Befehle, Sitzungsfenster öffnen, Ordnerdialog für Laufwerksfreigaben, Updates.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "deep-link:default",
    "updater:default"
  ]
}
