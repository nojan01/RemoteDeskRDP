+#if !defined(WITH_FUSE)
+/* ------------------------------------------------------------------------
+ * Abholung ohne FUSE (macOS)
+ *
+ * FreeRDP setzt fuer die Richtung Sitzung -> Mac sonst FUSE voraus: der
+ * Server liefert nur eine Beschreibungsliste, die Inhalte muessen einzeln
+ * per CB_FILECONTENTS_REQUEST angefordert werden. Unter macOS gibt es kein
+ * FUSE ohne fremde Kernel-Erweiterung, deshalb holt RemoteDeskRDP die
+ * Dateien vollstaendig ab und legt sie in einem echten Ordner ab.
+ *
+ * Ablauf: update_server_data merkt sich die Liste und startet den Thread
+ * unten. Der Thread fordert Stueck fuer Stueck an; die Antworten treffen im
+ * Kanal-Thread ein und wecken ihn. Der SDL-Thread wartet vor dem Einfuegen
+ * per cliprdr_file_context_wait_for_files() auf das Ende. Warten darf nur
+ * der SDL-Thread - wartete der Kanal-Thread, koennte er die Antworten nicht
+ * mehr entgegennehmen und die Abholung liefe in die Zeitsperre.
+ * ------------------------------------------------------------------------ */
+
+#define DOWNLOAD_CHUNK_SIZE (1024UL * 1024UL)
+#define DOWNLOAD_REPLY_TIMEOUT_MS 30000
+
+static void cliprdr_download_clear_reply(CliprdrFileContext* file)
+{
+	free(file->dl_reply_data);
+	file->dl_reply_data = nullptr;
+	file->dl_reply_size = 0;
+	file->dl_reply_ok = FALSE;
+}
+
+static UINT cliprdr_file_context_server_file_contents_response(
+    CliprdrClientContext* cliprdr_context,
+    const CLIPRDR_FILE_CONTENTS_RESPONSE* file_contents_response)
+{
+	WINPR_ASSERT(cliprdr_context);
+	WINPR_ASSERT(file_contents_response);
+
+	CliprdrFileContext* file = cliprdr_context->custom;
+	WINPR_ASSERT(file);
+
+	EnterCriticalSection(&file->dl_lock);
+	if (file_contents_response->streamId != file->dl_stream_id)
+	{
+		/* Verspaetete Antwort einer abgebrochenen Anfrage. */
+		LeaveCriticalSection(&file->dl_lock);
+		return CHANNEL_RC_OK;
+	}
+
+	cliprdr_download_clear_reply(file);
+
+	if (file_contents_response->common.msgFlags & CB_RESPONSE_OK)
+	{
+		const UINT32 size = file_contents_response->cbRequested;
+		if (size == 0)
+			file->dl_reply_ok = TRUE;
+		else
+		{
+			BYTE* copy = malloc(size);
+			if (copy)
+			{
+				memcpy(copy, file_contents_response->requestedData, size);
+				file->dl_reply_data = copy;
+				file->dl_reply_size = size;
+				file->dl_reply_ok = TRUE;
+			}
+		}
+	}
+	LeaveCriticalSection(&file->dl_lock);
+
+	(void)SetEvent(file->dl_reply_event);
+	return CHANNEL_RC_OK;
+}
+
+/* Sendet eine Anfrage und wartet auf die Antwort. Bei Erfolg gehoert der
+ * Speicher unter *data dem Aufrufer. */
+static BOOL cliprdr_download_request(CliprdrFileContext* file, UINT32 listIndex, UINT32 flags,
+                                     UINT64 offset, UINT32 cbRequested, BYTE** data, UINT32* size)
+{
+	CLIPRDR_FILE_CONTENTS_REQUEST request = WINPR_C_ARRAY_INIT;
+
+	if (data)
+		*data = nullptr;
+	if (size)
+		*size = 0;
+
+	if (!file->context)
+		return FALSE;
+
+	(void)ResetEvent(file->dl_reply_event);
+
+	EnterCriticalSection(&file->dl_lock);
+	cliprdr_download_clear_reply(file);
+	const UINT32 streamId = ++file->dl_stream_id;
+	LeaveCriticalSection(&file->dl_lock);
+
+	request.common.msgType = CB_FILECONTENTS_REQUEST;
+	request.streamId = streamId;
+	request.listIndex = listIndex;
+	request.dwFlags = flags;
+	request.nPositionLow = (UINT32)(offset & 0xFFFFFFFF);
+	request.nPositionHigh = (UINT32)(offset >> 32);
+	request.cbRequested = cbRequested;
+	request.haveClipDataId = file->dl_have_clip_data_id;
+	request.clipDataId = file->dl_clip_data_id;
+
+	if (file->context->ClientFileContentsRequest(file->context, &request))
+	{
+		WLog_Print(file->log, WLOG_ERROR, "FileContentsRequest fuer Eintrag %" PRIu32 " scheiterte",
+		           listIndex);
+		return FALSE;
+	}
+
+	HANDLE handles[2] = { file->dl_reply_event, file->dl_abort };
+	const DWORD status = WaitForMultipleObjects(2, handles, FALSE, DOWNLOAD_REPLY_TIMEOUT_MS);
+	if (status != WAIT_OBJECT_0)
+	{
+		WLog_Print(file->log, WLOG_ERROR,
+		           "Keine Antwort auf FileContentsRequest fuer Eintrag %" PRIu32, listIndex);
+		EnterCriticalSection(&file->dl_lock);
+		file->dl_stream_id++; /* spaetere Antwort verwerfen */
+		LeaveCriticalSection(&file->dl_lock);
+		return FALSE;
+	}
+
+	BOOL rc = FALSE;
+	EnterCriticalSection(&file->dl_lock);
+	if (file->dl_reply_ok)
+	{
+		if (data)
+		{
+			*data = file->dl_reply_data;
+			*size = file->dl_reply_size;
+			file->dl_reply_data = nullptr;
+			file->dl_reply_size = 0;
+		}
+		rc = TRUE;
+	}
+	cliprdr_download_clear_reply(file);
+	LeaveCriticalSection(&file->dl_lock);
+
+	return rc;
+}
+
+/* Wandelt den Namen aus der Beschreibungsliste in einen lokalen Pfad. Der
+ * Server trennt mit Backslash, macOS mit Schraegstrich. */
+static char* cliprdr_download_local_path(CliprdrFileContext* file, const FILEDESCRIPTORW* desc)
+{
+	char name[520] = WINPR_C_ARRAY_INIT;
+
+	if (ConvertWCharNToUtf8(desc->cFileName, ARRAYSIZE(desc->cFileName), name, ARRAYSIZE(name)) < 0)
+		return nullptr;
+
+	/* Kein Ausbrechen aus dem Zielordner. */
+	if (strstr(name, "..") || name[0] == '/' || name[0] == '\\')
+	{
+		WLog_Print(file->log, WLOG_WARN, "Verdaechtiger Dateiname \"%s\" wird uebersprungen", name);
+		return nullptr;
+	}
+
+	for (char* p = name; *p; p++)
+	{
+		if (*p == '\\')
+			*p = '/';
+	}
+
+	return GetCombinedPath(file->dl_dir, name);
+}
+
+static BOOL cliprdr_download_make_parents(const char* path)
+{
+	char* copy = _strdup(path);
+	if (!copy)
+		return FALSE;
+
+	BOOL rc = TRUE;
+	for (char* p = copy + 1; *p; p++)
+	{
+		if (*p != '/')
+			continue;
+		*p = '\0';
+		if (!winpr_PathFileExists(copy) && !winpr_PathMakePath(copy, nullptr))
+		{
+			rc = FALSE;
+			break;
+		}
+		*p = '/';
+	}
+
+	free(copy);
+	return rc;
+}
+
+static BOOL cliprdr_download_one(CliprdrFileContext* file, UINT32 index)
+{
+	const FILEDESCRIPTORW* desc = &file->dl_files[index];
+
+	char* path = cliprdr_download_local_path(file, desc);
+	if (!path)
+		return FALSE;
+
+	BOOL rc = FALSE;
+	const BOOL isDirectory =
+	    (desc->dwFlags & FD_ATTRIBUTES) && (desc->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);
+
+	if (isDirectory)
+	{
+		rc = winpr_PathFileExists(path) || winpr_PathMakePath(path, nullptr);
+		if (!rc)
+			WLog_Print(file->log, WLOG_ERROR, "Ordner \"%s\" liess sich nicht anlegen", path);
+		goto out;
+	}
+
+	if (!cliprdr_download_make_parents(path))
+	{
+		WLog_Print(file->log, WLOG_ERROR, "Elternordner von \"%s\" liess sich nicht anlegen", path);
+		goto out;
+	}
+
+	UINT64 total = 0;
+	if (desc->dwFlags & FD_FILESIZE)
+		total = ((UINT64)desc->nFileSizeHigh << 32) | desc->nFileSizeLow;
+	else
+	{
+		BYTE* sizeData = nullptr;
+		UINT32 sizeLen = 0;
+		if (!cliprdr_download_request(file, index, FILECONTENTS_SIZE, 0, sizeof(UINT64), &sizeData,
+		                              &sizeLen))
+			goto out;
+		if (sizeLen >= sizeof(UINT64))
+			memcpy(&total, sizeData, sizeof(UINT64));
+		free(sizeData);
+	}
+
+	FILE* fp = winpr_fopen(path, "wb");
+	if (!fp)
+	{
+		WLog_Print(file->log, WLOG_ERROR, "Datei \"%s\" liess sich nicht anlegen", path);
+		goto out;
+	}
+
+	UINT64 offset = 0;
+	rc = TRUE;
+	while (offset < total)
+	{
+		const UINT64 remaining = total - offset;
+		const UINT32 want =
+		    (remaining > DOWNLOAD_CHUNK_SIZE) ? DOWNLOAD_CHUNK_SIZE : (UINT32)remaining;
+
+		BYTE* chunk = nullptr;
+		UINT32 got = 0;
+		if (!cliprdr_download_request(file, index, FILECONTENTS_RANGE, offset, want, &chunk, &got))
+		{
+			rc = FALSE;
+			break;
+		}
+
+		if (got == 0)
+		{
+			free(chunk);
+			WLog_Print(file->log, WLOG_WARN, "\"%s\" endete nach %" PRIu64 " von %" PRIu64 " Byte",
+			           path, offset, total);
+			break;
+		}
+
+		const size_t written = fwrite(chunk, 1, got, fp);
+		free(chunk);
+		if (written != got)
+		{
+			WLog_Print(file->log, WLOG_ERROR, "Schreibfehler in \"%s\"", path);
+			rc = FALSE;
+			break;
+		}
+		offset += got;
+	}
+
+	(void)fclose(fp);
+	if (rc)
+		WLog_Print(file->log, WLOG_DEBUG, "\"%s\" abgeholt (%" PRIu64 " Byte)", path, offset);
+
+out:
+	free(path);
+	return rc;
+}
+
+static DWORD WINAPI cliprdr_download_thread(LPVOID arg)
+{
+	CliprdrFileContext* file = arg;
+
+	UINT32 failed = 0;
+	for (UINT32 i = 0; i < file->dl_n_files; i++)
+	{
+		if (WaitForSingleObject(file->dl_abort, 0) == WAIT_OBJECT_0)
+			break;
+		if (!cliprdr_download_one(file, i))
+			failed++;
+	}
+
+	if (failed)
+		WLog_Print(file->log, WLOG_WARN, "%" PRIu32 " von %" PRIu32 " Eintraegen fehlgeschlagen",
+		           failed, file->dl_n_files);
+	else
+		WLog_Print(file->log, WLOG_DEBUG, "%" PRIu32 " Eintraege abgeholt", file->dl_n_files);
+
+	return 0;
+}
+
+static void cliprdr_download_stop(CliprdrFileContext* file)
+{
+	if (!file->dl_thread)
+		return;
+
+	(void)SetEvent(file->dl_abort);
+	(void)WaitForSingleObject(file->dl_thread, INFINITE);
+	(void)CloseHandle(file->dl_thread);
+	file->dl_thread = nullptr;
+	(void)ResetEvent(file->dl_abort);
+}
+
+BOOL cliprdr_file_context_wait_for_files(CliprdrFileContext* file, UINT32 timeoutMs)
+{
+	if (!file)
+		return TRUE;
+
+	/* Erst hier wird geholt: der Aufrufer fuegt gerade ein. Beim blossen
+	 * Kopieren im Gast bleibt es bei der Namensliste. */
+	if (!file->dl_thread)
+	{
+		if (file->dl_done || file->dl_n_files == 0 || !file->dl_dir)
+			return TRUE;
+
+		file->dl_thread = CreateThread(nullptr, 0, cliprdr_download_thread, file, 0, nullptr);
+		if (!file->dl_thread)
+		{
+			WLog_Print(file->log, WLOG_ERROR, "Abholung liess sich nicht starten");
+			return FALSE;
+		}
+		WLog_Print(file->log, WLOG_DEBUG, "Hole %" PRIu32 " Eintraege nach \"%s\"",
+		           file->dl_n_files, file->dl_dir);
+	}
+
+	const DWORD status = WaitForSingleObject(file->dl_thread, timeoutMs);
+	if (status != WAIT_OBJECT_0)
+	{
+		WLog_Print(file->log, WLOG_WARN, "Abholung laeuft noch, Einfuegen kann unvollstaendig sein");
+		return FALSE;
+	}
+
+	(void)CloseHandle(file->dl_thread);
+	file->dl_thread = nullptr;
+	file->dl_done = TRUE;
+	return TRUE;
+}
+#else
+BOOL cliprdr_file_context_wait_for_files(CliprdrFileContext* file, UINT32 timeoutMs)
+{
+	WINPR_UNUSED(file);
+	WINPR_UNUSED(timeoutMs);
+	return TRUE;
+}
