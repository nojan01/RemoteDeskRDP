+/* RemoteDesk: Ziehen und Fallenlassen vom Mac in die Sitzung.
+ *
+ * RDP kennt keinen Kanal fuer Ziehen und Fallenlassen -- der einzige Weg,
+ * Dateien in den Gast zu bringen, ist die Zwischenablage (cliprdr).  Deshalb
+ * wird beim Loslassen die Dateiliste dem Gast angeboten, der Zeiger an die
+ * Stelle des Loslassens gesetzt und dort Strg+V ausgeloest.  Fuer den Nutzer
+ * sieht das aus wie gewoehnliches Ablegen.
+ */
+bool SdlContext::handleEvent(const SDL_DropEvent& ev)
+{
+	switch (ev.type)
+	{
+		case SDL_EVENT_DROP_BEGIN:
+			_dropPaths.clear();
+			_dropWindow = ev.windowID;
+			return true;
+
+		case SDL_EVENT_DROP_POSITION:
+			_dropWindow = ev.windowID;
+			_dropX = ev.x;
+			_dropY = ev.y;
+			return true;
+
+		case SDL_EVENT_DROP_FILE:
+			if (ev.data)
+				_dropPaths.emplace_back(ev.data);
+			_dropWindow = ev.windowID;
+			_dropX = ev.x;
+			_dropY = ev.y;
+			return true;
+
+		case SDL_EVENT_DROP_COMPLETE:
+			return finishDrop();
+
+		default:
+			return true;
+	}
+}
+
+bool SdlContext::finishDrop()
+{
+	auto paths = std::move(_dropPaths);
+	_dropPaths.clear();
+
+	if (paths.empty())
+		return true;
+
+	if (!getWindowForId(_dropWindow))
+	{
+		WLog_Print(_log, WLOG_WARN, "Ablegen auf unbekanntem Fenster verworfen");
+		return true;
+	}
+
+	if (!getClipboardChannelContext().offerDroppedFiles(paths))
+		return true; /* nicht toedlich, die Sitzung laeuft weiter */
+
+	/* Erst wenn der Gast die Formatliste bestaetigt hat, liegen die Dateien in
+	 * seiner Zwischenablage.  Ein sofortiges Strg+V ginge ins Leere. */
+	if (!getClipboardChannelContext().waitForDropAck(3000))
+		WLog_Print(_log, WLOG_WARN, "Gast bestaetigt die Dateiliste nicht, versuche es dennoch");
+
+	/* Dieselbe Umrechnung wie bei echten Mausereignissen, sonst zeigt der
+	 * Gastzeiger bei skalierten Fenstern an die falsche Stelle. */
+	SDL_Event copy{};
+	copy.motion.type = SDL_EVENT_MOUSE_MOTION;
+	copy.motion.windowID = _dropWindow;
+	copy.motion.x = _dropX;
+	copy.motion.y = _dropY;
+	if (!eventToPixelCoordinates(_dropWindow, copy))
+		return true;
+	removeLocalScaling(copy.motion.x, copy.motion.y);
+	applyMonitorOffset(copy.motion.windowID, copy.motion.x, copy.motion.y);
+
+	const auto px = static_cast<INT32>(copy.motion.x);
+	const auto py = static_cast<INT32>(copy.motion.y);
+
+	/* Ein kurzer Klick setzt den Fokus im Gast auf das Fenster unter dem
+	 * Zeiger -- ohne ihn landete Strg+V im zuletzt aktiven Fenster. */
+	std::ignore = freerdp_client_send_button_event(common(), FALSE, PTR_FLAGS_MOVE, px, py);
+	std::ignore = freerdp_client_send_button_event(common(), FALSE,
+	                                               PTR_FLAGS_BUTTON1 | PTR_FLAGS_DOWN, px, py);
+	std::ignore = freerdp_client_send_button_event(common(), FALSE, PTR_FLAGS_BUTTON1, px, py);
+
+	/* Dem Gast Zeit lassen, den Fokus zu setzen. */
+	Sleep(150);
+
+	auto input = context()->input;
+	WINPR_ASSERT(input);
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, TRUE, FALSE, RDP_SCANCODE_LCONTROL);
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, TRUE, FALSE, RDP_SCANCODE_KEY_V);
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, RDP_SCANCODE_KEY_V);
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, RDP_SCANCODE_LCONTROL);
+
+	WLog_Print(_log, WLOG_DEBUG, "%" PRIuz " Datei(en) bei %d,%d abgelegt", paths.size(), px, py);
+	return true;
+}
+
+/* RemoteDesk: Ziehen aus der Sitzung auf den Mac.
+ *
+ * RDP verraet dem Client nicht, dass im Gast gezogen wird -- der Server sendet
+ * dazu nichts. Der Client muss die Absicht daher aus dem erkennen, was er
+ * selbst sieht: gedrueckte linke Maustaste, gedrueckte Wahltaste und ein
+ * Zeiger, der das Fenster verlaesst. Die Wahltaste ist Absicht: ohne sie
+ * wuerde jedes Herausfahren mit gedrueckter Taste (etwa beim Markieren von
+ * Text) den Vorgang ausloesen.
+ *
+ * Ablauf: im Gast das Ziehen mit Esc abbrechen, Maustaste loslassen, mit
+ * Strg+C kopieren, auf die Dateiliste warten und dann einen echten
+ * macOS-Ziehvorgang starten.
+ */
+bool SdlContext::startDragOut()
+{
+	auto& clip = getClipboardChannelContext();
+	clip.armServerFileWait();
+
+	auto input = context()->input;
+	WINPR_ASSERT(input);
+
+	/* Die Wahltaste haelt der Nutzer gedrueckt; im Gast muss sie weg, sonst
+	 * entstuende Alt+Esc beziehungsweise Alt+C. */
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, RDP_SCANCODE_LMENU);
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, RDP_SCANCODE_RMENU);
+
+	/* Erst abbrechen, dann loslassen. Umgekehrt legte der Gast die Datei am
+	 * Fensterrand ab -- sie wuerde also verschoben. */
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, TRUE, FALSE, RDP_SCANCODE_ESCAPE);
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, RDP_SCANCODE_ESCAPE);
+	std::ignore = freerdp_client_send_button_event(common(), FALSE, PTR_FLAGS_BUTTON1, 0, 0);
+
+	Sleep(120);
+
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, TRUE, FALSE, RDP_SCANCODE_LCONTROL);
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, TRUE, FALSE, RDP_SCANCODE_KEY_C);
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, RDP_SCANCODE_KEY_C);
+	std::ignore = freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, RDP_SCANCODE_LCONTROL);
+
+	/* Wartet auf die Formatliste des Gasts, danach holt ClipDataCb die Inhalte
+	 * ab (dafuer gelten eigene, weit groessere Fristen). Traege Gastsysteme
+	 * brauchen nach dem Strg+C durchaus ein paar Sekunden. */
+	auto paths = clip.fetchServerFiles(10000);
+	if (paths.empty())
+	{
+		WLog_Print(_log, WLOG_DEBUG, "Herausziehen ohne Dateien, nichts zu tun");
+		return true;
+	}
+
+	/* macOS kann einen Ziehvorgang nur beginnen, solange die Maustaste
+	 * gedrueckt ist. Bei grossen Dateien dauert das Abholen laenger, als der
+	 * Nutzer haelt -- dann still aufhoeren. Die Dateien liegen durch das
+	 * Strg+C ohnehin in der Zwischenablage und lassen sich einfuegen. */
+	if ((SDL_GetGlobalMouseState(nullptr, nullptr) & SDL_BUTTON_LMASK) == 0)
+	{
+		WLog_Print(_log, WLOG_INFO,
+		           "Maustaste vor dem Ende des Abholens losgelassen, kein Ziehvorgang; "
+		           "die Dateien liegen in der Zwischenablage");
+		return true;
+	}
+
+	auto window = getWindowForId(_dragOutWindow);
+	if (!window)
+		return true;
+
+	std::vector<const char*> raw;
+	raw.reserve(paths.size());
+	for (const auto& p : paths)
+		raw.push_back(p.c_str());
+
+	if (!RemoteDesk_StartFileDrag(window->window(), raw.data(),
+	                              static_cast<int>(raw.size())))
+		WLog_Print(_log, WLOG_WARN, "macOS nahm den Ziehvorgang nicht an");
+	else
+		WLog_Print(_log, WLOG_DEBUG, "%" PRIuz " Datei(en) werden gezogen", paths.size());
+
+	return true;
+}
