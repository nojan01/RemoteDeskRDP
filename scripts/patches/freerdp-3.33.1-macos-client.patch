+char* cliprdr_file_context_download_server_files(CliprdrFileContext* file, const void* data,
+                                                 size_t size)
+{
+	WINPR_ASSERT(file);
+
+#if defined(WITH_CLIPRDR_FILE_APPLE)
+	if (!file->context || !data || !apple_set_server_files(file, data, size))
+		return nullptr;
+
+	char* list = nullptr;
+	size_t len = 0;
+	for (size_t x = 0; x < file->apple_top_level_count; x++)
+	{
+		char* path = apple_provide_file(file, x);
+		if (!path)
+		{
+			free(list);
+			return nullptr;
+		}
+
+		char* next = nullptr;
+		size_t nlen = 0;
+		const int rc = list ? winpr_asprintf(&next, &nlen, "%s\n%s", list, path)
+		                    : winpr_asprintf(&next, &nlen, "%s", path);
+		free(path);
+		free(list);
+		if (rc < 0)
+			return nullptr;
+		list = next;
+		len = nlen;
+	}
+	WLog_Print(file->log, WLOG_DEBUG, "downloaded %" PRIuz " server files (%" PRIuz " bytes)",
+	           file->apple_top_level_count, len);
+	return list;
+#else
+	WINPR_UNUSED(data);
+	WINPR_UNUSED(size);
+	return nullptr;
+#endif
+}
