+/* RemoteDesk: baut aus lokalen Pfaden eine "text/uri-list", wie sie
+ * freedesktop-Programme liefern. winpr entschluesselt die Prozentkodierung
+ * beim Zerlegen wieder (parse_uri_to_local_file), Leerzeichen und Umlaute
+ * muessen also kodiert werden.
+ */
+static std::string paths_to_uri_list(const std::vector<std::string>& paths)
+{
+	std::string list;
+	for (const auto& path : paths)
+	{
+		if (path.empty() || path.front() != '/')
+			continue;
+
+		/* Der Schraegstrich trennt die Bestandteile und darf nicht kodiert
+		 * werden, alles andere schon. Deshalb Abschnitt fuer Abschnitt. */
+		std::string encoded;
+		size_t pos = 0;
+		while (pos < path.size())
+		{
+			auto next = path.find('/', pos);
+			if (next == std::string::npos)
+				next = path.size();
+
+			if (next > pos)
+			{
+				auto part = path.substr(pos, next - pos);
+				auto enc = std::shared_ptr<char>(winpr_str_url_encode(part.c_str(), part.size()),
+				                                 free);
+				if (!enc)
+					return {};
+				encoded += enc.get();
+			}
+			if (next < path.size())
+				encoded += '/';
+			pos = next + 1;
+		}
+
+		list += "file://";
+		list += encoded;
+		list += "\r\n";
+	}
+	return list;
+}
+
+bool sdlClip::offerDroppedFiles(const std::vector<std::string>& paths)
+{
+	if (!_ctx || !_sync || paths.empty())
+	{
+		WLog_Print(_log, WLOG_WARN, "Ablegen ignoriert: Kanal noch nicht bereit");
+		return false;
+	}
+
+	auto list = paths_to_uri_list(paths);
+	if (list.empty())
+		return false;
+
+	std::ignore = ResetEvent(_drop_ack);
+
+	CLIPRDR_FORMAT format = {};
+	std::string name = s_type_FileGroupDescriptorW;
+	{
+		ClipboardLockGuard systemlock(_system);
+		std::scoped_lock lock(_lock);
+		clearServerFormats();
+		_drop_uri_list = list;
+		format.formatId = ClipboardRegisterFormat(_system, name.c_str());
+		format.formatName = name.data();
+	}
+
+	if (!cliprdr_file_context_set_locally_available(_file, TRUE))
+		return false;
+
+	const CLIPRDR_FORMAT_LIST formatList = {
+		{ CB_FORMAT_LIST, 0, 0 },
+		1,
+		&format,
+	};
+
+	WLog_Print(_log, WLOG_DEBUG, "%" PRIuz " abgelegte Datei(en) werden angeboten", paths.size());
+
+	if (cliprdr_file_context_notify_new_client_format_list(_file) != CHANNEL_RC_OK)
+		return false;
+
+	WINPR_ASSERT(_ctx->ClientFormatList);
+	return _ctx->ClientFormatList(_ctx, &formatList) == CHANNEL_RC_OK;
+}
+
+bool sdlClip::waitForDropAck(uint32_t timeoutMs)
+{
+	return WaitForSingleObject(_drop_ack, timeoutMs) == WAIT_OBJECT_0;
+}
+
+void sdlClip::armServerFileWait()
+{
+	if (_server_files)
+		std::ignore = ResetEvent(_server_files);
+}
+
+std::vector<std::string> sdlClip::fetchServerFiles(uint32_t timeoutMs)
+{
+	std::vector<std::string> paths;
+
+	if (!_server_files || !_sdl)
+		return paths;
+
+	/* Auf die Formatliste des Gasts warten. Sie kommt im Kanal-Thread an,
+	 * hier darf deshalb keine Sperre gehalten werden. */
+	HANDLE hdl[2] = { freerdp_abort_event(_sdl->context()), _server_files };
+	if (WaitForMultipleObjects(ARRAYSIZE(hdl), hdl, FALSE, timeoutMs) != WAIT_OBJECT_0 + 1)
+	{
+		WLog_Print(_log, WLOG_DEBUG, "Gast bietet keine Dateien an");
+		return paths;
+	}
+
+	/* Die Dateiliste roh holen, wie es cliprdr_file_context_set_local_clipboard_data
+	 * auch tut. Das Clipboard-Ereignis dazu steht noch in der Warteschlange des
+	 * SDL-Threads, der hier blockiert. */
+	size_t size = 0;
+	auto data = ClipDataCb(this, s_type_FileGroupDescriptorW, &size);
+	if (!data || (size == 0))
+	{
+		WLog_Print(_log, WLOG_WARN, "Dateiliste des Gasts ist leer");
+		return paths;
+	}
+
+	/* Laedt alle Dateien herunter und liefert die lokalen Pfade, je Zeile einer.
+	 * Windows-Dateinamen enthalten keinen Zeilenumbruch. */
+	auto list = std::unique_ptr<char, decltype(&free)>(
+	    cliprdr_file_context_download_server_files(_file, data, size), free);
+	if (!list)
+	{
+		WLog_Print(_log, WLOG_WARN, "Dateien des Gasts nicht abgeholt");
+		return paths;
+	}
+
+	std::string_view all(list.get());
+	while (!all.empty())
+	{
+		const auto end = all.find('\n');
+		const auto line = all.substr(0, end);
+		if (!line.empty())
+			paths.emplace_back(line);
+		if (end == std::string_view::npos)
+			break;
+		all.remove_prefix(end + 1);
+	}
+
+	WLog_Print(_log, WLOG_DEBUG, "%" PRIuz " Datei(en) aus der Sitzung bereit", paths.size());
+	return paths;
+}
