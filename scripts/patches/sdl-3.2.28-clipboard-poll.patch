RemoteDesk-Patch für SDL 3.2.28 (release-3.2.28)

Zweck
  1. macOS meldet Änderungen der Zwischenablage nicht als Ereignis.  SDL
     gleicht sie deshalb nur in windowDidBecomeKey ab.  Solange das
     RDP-Fenster den Tastaturfokus behält, bemerkt SDL nie, dass in einem
     anderen Programm etwas kopiert wurde -- der FreeRDP-Client meldet dem
     Server dauerhaft "ClientFormatList: numFormats: 0" und Einfügen in der
     Sitzung bleibt leer.  Nachgemessen mit /log-level:DEBUG gegen xrdp:
     Server -> Mac funktionierte, Mac -> Server nie.

  2. Enthaelt das Bundle ein Main-Nib (NSMainNibFile), so laedt SDL es fuer das
     Menue.  Cocoa zeigt dabei jedes Fenster an, das im Nib "Visible At Launch"
     ist.  Der SDL-Client von FreeRDP liegt im Bundle des Cocoa-Clients und
     erbt dessen MainMenu.nib, das ein Sitzungsfenster von 1024x768 enthaelt.
     Beim Start jeder Sitzung stand daher ein zweites, leeres Fenster mit dem
     Titel "FreeRDP" neben dem eigentlichen.  Nachgemessen mit
     CGWindowListCopyWindowInfo: ein Prozess, zwei Fenster -- das Sitzungs-
     fenster und eines von 1024x800 (1024x768 zuzueglich Titelleiste).

  3. SDL kann Ablegen nur empfangen (performDragOperation), aber keinen
     Ziehvorgang beginnen -- eine oeffentliche Schnittstelle dafuer gibt es
     nicht.  Ziehen aus der Sitzung auf den Mac braucht das aber.

  Dateien in der Zwischenablage (public.file-url, Finder-Kennungen der Form
  "file:///.file/id=...") behandelt FreeRDP seit 3.33 selbst
  (client/common/client_cliprdr_file_apple.m).  Die frueheren Teile dieses
  Patches fuer SDL_cocoaclipboard.m sind deshalb entfallen.

Lösung
  1. Cocoa_PumpEvents gleicht die Zwischenablage zusätzlich gedrosselt ab
     (höchstens alle 250 ms).  Der Abgleich kostet nur einen Vergleich von
     [NSPasteboard changeCount] und belastet den Renderpfad nicht.

  2. LoadMainMenuNibIfAvailable holt die obersten Objekte des Nibs ab und
     blendet enthaltene NSWindow-Objekte mit "orderOut:" aus.  Das Menue
     bleibt erhalten.  SDL legt seine Fenster ausschliesslich ueber
     SDL_CreateWindow an, ein Fenster aus dem Nib kann also nie ein
     SDL-Fenster sein.

  3. RemoteDesk_StartFileDrag startet einen echten macOS-Ziehvorgang.  Der
     FreeRDP-Client holt die Dateien aus dem Gast ueber die Zwischenablage ab
     und uebergibt die fertigen Pfade hier.  Das Ereignis wird frisch erzeugt
     statt "currentEvent" zu benutzen, denn zwischen dem Herausziehen und dem
     Ende des Downloads koennen Sekunden liegen.  Die Quelle liegt in einer
     statischen Variablen, weil der Ziehvorgang sie nur schwach haelt.

Anwenden
  git -C <SDL-Quellbaum> apply sdl-3.2.28-clipboard-poll.patch

  Das übernimmt scripts/build-freerdp-backend.sh automatisch, indem es
  REMOTEDESK_SDL_PATCH setzt; FreeRDPs scripts/bundle-mac-os.sh wendet den
  Patch nach dem Klonen an (siehe freerdp-3.33.1-macos-client.patch).

diff --git a/src/video/cocoa/SDL_cocoaevents.m b/src/video/cocoa/SDL_cocoaevents.m
index fd178b8..2525800 100644
--- a/src/video/cocoa/SDL_cocoaevents.m
+++ b/src/video/cocoa/SDL_cocoaevents.m
@@ -414,7 +414,23 @@ static bool LoadMainMenuNibIfAvailable(void)
         mainNibFileName = [infoDict valueForKey:@"NSMainNibFile"];
 
         if (mainNibFileName) {
-            success = [[NSBundle mainBundle] loadNibNamed:mainNibFileName owner:[NSApplication sharedApplication] topLevelObjects:nil];
+            NSArray *topLevel = nil;
+            success = [[NSBundle mainBundle] loadNibNamed:mainNibFileName owner:[NSApplication sharedApplication] topLevelObjects:&topLevel];
+
+            /* Nur das Menue aus dem Nib wird gebraucht.  Enthaelt das Nib
+             * zusaetzlich ein Fenster, so zeigt Cocoa es beim Laden an
+             * ("Visible At Launch") -- es steht dann leer neben den Fenstern,
+             * die SDL selbst anlegt.  SDL verwaltet seine Fenster
+             * ausschliesslich ueber SDL_CreateWindow, ein Fenster aus dem Nib
+             * kann daher nie ein SDL-Fenster sein und wird ausgeblendet.
+             */
+            if (success) {
+                for (id object in topLevel) {
+                    if ([object isKindOfClass:[NSWindow class]]) {
+                        [(NSWindow *)object orderOut:nil];
+                    }
+                }
+            }
         }
     }
 
@@ -640,6 +656,21 @@ void Cocoa_PumpEvents(SDL_VideoDevice *_this)
 {
     @autoreleasepool {
         Cocoa_PumpEventsUntilDate(_this, [NSDate distantPast], true);
+
+        /* macOS kennt kein Ereignis für Änderungen der Zwischenablage.  SDL
+           gleicht sie sonst ausschliesslich in windowDidBecomeKey ab, weshalb
+           in anderen Programmen kopierte Inhalte nie gemeldet werden, solange
+           das Fenster den Tastaturfokus behält.  Ein gedrosselter Abgleich
+           kostet nur einen changeCount-Vergleich und behebt das.  SDL hält
+           immer höchstens ein Video-Device, daher genügt ein statischer
+           Zeitstempel. */
+        static Uint64 clipboard_checked_at = 0;
+        const Uint64 now = SDL_GetTicks();
+
+        if (now - clipboard_checked_at >= 250) {
+            clipboard_checked_at = now;
+            Cocoa_CheckClipboardUpdate((__bridge SDL_CocoaVideoData *)_this->internal);
+        }
     }
 }
 
diff --git a/src/video/cocoa/SDL_cocoawindow.m b/src/video/cocoa/SDL_cocoawindow.m
index 18c79a2..954257a 100644
--- a/src/video/cocoa/SDL_cocoawindow.m
+++ b/src/video/cocoa/SDL_cocoawindow.m
@@ -3370,4 +3370,99 @@ bool Cocoa_SyncWindow(SDL_VideoDevice *_this, SDL_Window *window)
     return result;
 }
 
+/* RemoteDeskRDP: Ziehen aus der Sitzung auf den Mac.
+ *
+ * SDL kann Ablegen nur empfangen (performDragOperation weiter oben), aber
+ * keinen Ziehvorgang starten -- dafuer gibt es keine oeffentliche API. RDP
+ * wiederum meldet dem Client nicht, dass im Gast gezogen wird. Der Client
+ * holt die Dateien deshalb ueber die Zwischenablage ab und uebergibt die
+ * fertigen Pfade hier, damit macOS ab dort einen echten Ziehvorgang fuehrt.
+ */
+
+@interface RemoteDeskDragSource : NSObject <NSDraggingSource>
+@end
+
+@implementation RemoteDeskDragSource
+- (NSDragOperation)draggingSession:(NSDraggingSession *)session
+    sourceOperationMaskForDraggingContext:(NSDraggingContext)context
+{
+    /* Kopieren, nicht Verschieben: die Dateien liegen in einem temporaeren
+     * Ordner des Clients, ein Verschieben wuerde sie dort herausreissen. */
+    return NSDragOperationCopy;
+}
+@end
+
+/* Der Ziehvorgang haelt die Quelle nur schwach; ohne diese Referenz wird sie
+ * sofort freigegeben und macOS bricht ab. */
+static RemoteDeskDragSource *s_remotedesk_drag_source = nil;
+
+__attribute__((visibility("default"))) bool RemoteDesk_StartFileDrag(SDL_Window *window,
+                                                                    const char *const *paths,
+                                                                    int count)
+{
+    if (!window || !paths || count <= 0) {
+        return false;
+    }
+
+    @autoreleasepool {
+        SDL_CocoaWindowData *data = (__bridge SDL_CocoaWindowData *)window->internal;
+        if (!data || !data.sdlContentView) {
+            return false;
+        }
+        NSView *view = data.sdlContentView;
+
+        NSMutableArray *items = [NSMutableArray arrayWithCapacity:(NSUInteger)count];
+        for (int i = 0; i < count; i++) {
+            if (!paths[i]) {
+                continue;
+            }
+            NSString *path = [NSString stringWithUTF8String:paths[i]];
+            if (!path) {
+                continue;
+            }
+            NSURL *url = [NSURL fileURLWithPath:path];
+            if (!url) {
+                continue;
+            }
+            NSDraggingItem *item = [[NSDraggingItem alloc] initWithPasteboardWriter:url];
+            /* Ohne Bild zeigt macOS nichts an; das Symbol des Finders passt. */
+            NSImage *icon = [[NSWorkspace sharedWorkspace] iconForFile:path];
+            NSRect frame = NSMakeRect(0.0, 0.0, 48.0, 48.0);
+            [item setDraggingFrame:frame contents:icon];
+            [items addObject:item];
+        }
+        if ([items count] == 0) {
+            return false;
+        }
+
+        /* Das zuletzt verarbeitete Ereignis taugt nicht: zwischen dem
+         * Herausziehen und dem Ende des Downloads koennen Sekunden liegen.
+         * Deshalb ein frisches Ereignis an der aktuellen Zeigerposition. */
+        NSPoint screen = [NSEvent mouseLocation];
+        NSRect screenRect = NSMakeRect(screen.x, screen.y, 0.0, 0.0);
+        NSPoint inWindow = [[view window] convertRectFromScreen:screenRect].origin;
+        NSEvent *ev = [NSEvent mouseEventWithType:NSEventTypeLeftMouseDragged
+                                         location:inWindow
+                                    modifierFlags:0
+                                        timestamp:[[NSProcessInfo processInfo] systemUptime]
+                                     windowNumber:[[view window] windowNumber]
+                                          context:nil
+                                      eventNumber:0
+                                       clickCount:1
+                                         pressure:1.0];
+        if (!ev) {
+            return false;
+        }
+
+        if (!s_remotedesk_drag_source) {
+            s_remotedesk_drag_source = [[RemoteDeskDragSource alloc] init];
+        }
+
+        NSDraggingSession *session = [view beginDraggingSessionWithItems:items
+                                                                   event:ev
+                                                                  source:s_remotedesk_drag_source];
+        return session != nil;
+    }
+}
+
 #endif // SDL_VIDEO_DRIVER_COCOA
