+/* RemoteDesk: Ein Datenanbieter fuer genau eine Datei-URL. macOS kennt
+ * "text/uri-list" nicht - UTTypeCreatePreferredIdentifierForTag macht daraus
+ * einen dynamischen Typ ("dyn."), den der Finder nicht als Datei erkennt, und
+ * das Menue "Einfuegen" bleibt aus. Der Finder erwartet "public.file-url" mit
+ * genau einer URL je Pasteboard-Element. Dieser Anbieter holt beim Zugriff die
+ * vollstaendige Liste ueber den internen Typ (der zugleich den Abruf der
+ * Inhalte abwartet) und gibt daraus seine Zeile zurueck. Erst beim Einfuegen -
+ * blosses Kopieren im Gast loest also keine Uebertragung aus. */
+@interface Cocoa_FileURLProvider : NSObject<NSPasteboardItemDataProvider>
+{
+    SDL_ClipboardDataCallback m_callback;
+    void *m_userdata;
+    NSUInteger m_index;
+}
+@end
+
+@implementation Cocoa_FileURLProvider
+
+- (nullable instancetype)initWith:(SDL_ClipboardDataCallback)callback
+                         userData:(void *)userdata
+                            index:(NSUInteger)index
+{
+    self = [super init];
+    if (!self) {
+        return self;
+    }
+    m_callback = callback;
+    m_userdata = userdata;
+    m_index = index;
+    return self;
+}
+
+- (void)pasteboard:(NSPasteboard *)pasteboard
+              item:(NSPasteboardItem *)item
+provideDataForType:(NSPasteboardType)type
+{
+    @autoreleasepool {
+        size_t size = 0;
+        const void *raw = m_callback(m_userdata, FILES_READY_MIME_TYPE, &size);
+        if (raw == NULL || size == 0) {
+            return;
+        }
+
+        NSString *list = [[NSString alloc] initWithBytes:raw
+                                                  length:size
+                                                encoding:NSUTF8StringEncoding];
+        if (list == nil) {
+            return;
+        }
+
+        NSMutableArray<NSString *> *urls = [NSMutableArray new];
+        for (NSString *line in [list componentsSeparatedByString:@"\n"]) {
+            NSString *trimmed = [line stringByTrimmingCharactersInSet:
+                                          [NSCharacterSet whitespaceAndNewlineCharacterSet]];
+            /* Kommentarzeilen sind im uri-list-Format zulaessig. */
+            if ([trimmed length] > 0 && ![trimmed hasPrefix:@"#"]) {
+                [urls addObject:trimmed];
+            }
+        }
+
+        if (m_index >= [urls count]) {
+            return;
+        }
+        [item setString:urls[m_index] forType:type];
+    }
+}
+
+@end
+
+/* RemoteDesk: Wie viele Dateien liegen an? Der Aufruf mit "text/uri-list"
+ * besorgt nur die Namensliste, nicht die Inhalte. */
+static NSUInteger CountAdvertisedFiles(SDL_ClipboardDataCallback callback, void *userdata)
+{
+    size_t size = 0;
+    const void *raw = callback(userdata, URI_LIST_MIME_TYPE, &size);
+    if (raw == NULL || size == 0) {
+        return 0;
+    }
+
+    NSString *list = [[NSString alloc] initWithBytes:raw length:size encoding:NSUTF8StringEncoding];
+    if (list == nil) {
+        return 0;
+    }
+
+    NSUInteger count = 0;
+    for (NSString *line in [list componentsSeparatedByString:@"\n"]) {
+        NSString *trimmed =
+            [line stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+        if ([trimmed length] > 0 && ![trimmed hasPrefix:@"#"]) {
+            count++;
+        }
+    }
+    return count;
+}
