 #include <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
 
+/* RemoteDesk: macOS legt kopierte Dateien als "public.file-url" ab, ein Eintrag
+ * je Datei. Anwendungen, die dem freedesktop-Standard folgen (etwa FreeRDP),
+ * erwarten dagegen "text/uri-list" mit allen Dateien in einer Liste. Deshalb
+ * wird dieser Typ hier aus den vorhandenen Datei-URLs zusammengesetzt. */
+static const char *URI_LIST_MIME_TYPE = "text/uri-list";
+/* RemoteDesk: muss zu s_mime_files_ready in sdl_clip.cpp passen. */
+static const char *FILES_READY_MIME_TYPE = "application/x-remotedeskrdp-files";
+static NSString *const FILE_URL_UTI = @"public.file-url";
+
+static BOOL PasteboardHasFileURLs(void)
+{
+    for (NSPasteboardItem *item in [[NSPasteboard generalPasteboard] pasteboardItems]) {
+        if ([item dataForType:FILE_URL_UTI] != nil) {
+            return YES;
+        }
+    }
+    return NO;
+}
+
+/* RemoteDesk: Der Finder legt keine Pfad-URLs ab, sondern File-Reference-URLs
+ * der Form "file:///.file/id=6571367.121757495". Wörtlich gelesen ergibt das
+ * den Pfad "/.file/id=...", den es im Dateisystem nicht gibt – ein Empfänger
+ * scheitert dort beim stat(). "filePathURL" löst die Kennung in den echten
+ * Pfad auf. Lässt sich eine URL nicht auflösen, bleibt sie unverändert. */
+static NSString *ResolveFileURL(NSString *urlString)
+{
+    NSURL *url = [NSURL URLWithString:urlString];
+    if (url != nil) {
+        NSURL *pathURL = [url filePathURL];
+        if (pathURL != nil) {
+            NSString *resolved = [pathURL absoluteString];
+            if (resolved != nil && [resolved length] > 0) {
+                return resolved;
+            }
+        }
+    }
+    return urlString;
+}
