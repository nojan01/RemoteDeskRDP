<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>MacFreeRDP</string>
  <key>CFBundleIdentifier</key>
  <string>com.remotedesk.macfreerdp</string>
  <!-- Ohne CFBundleIconFile zeigt macOS das graue Ersatzsymbol.  Der Name
       steht ohne Endung; die Datei legt build-freerdp-backend.sh daneben. -->
  <key>CFBundleIconFile</key>
  <string>RemoteDeskRDP</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <!-- Sichtbar im Dock und in der Menueleiste, solange das Sitzungsfenster
       vorne ist.  Der Ordnername MacFreeRDP.app bleibt unangetastet - darauf
       zeigen BUNDLED_BACKENDS in lib.rs und verify-rdp-backend.mjs. -->
  <key>CFBundleName</key>
  <string>RemoteDeskRDP</string>
  <key>CFBundleDisplayName</key>
  <string>RemoteDeskRDP</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>3.26.0</string>
  <key>CFBundleVersion</key>
  <string>3.26.0</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSMainNibFile</key>
  <string>MainMenu</string>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
</dict>
</plist>
